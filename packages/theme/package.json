{
  "name": "@lolita-ui/theme",
  "version": "0.1.0",
  "homepage": "https://github.com/1243sd/l-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1243sd/l-ui.git"
  },
  "bugs": {
    "url": "https://github.com/1243sd/l-ui/issues"
  },
  "keywords": [
    "lolita-ui",
    "vue",
    "theme",
    "design-tokens"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && pnpm run build:types",
    "build:types": "vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "vue-tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@lolita-ui/tokens": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.14"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.10"
  }
}
